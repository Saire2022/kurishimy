        "end": 289310
      },
      {
        "word": "Explotación limpia y segura kan.",
        "start": 289330,
        "end": 291680
      },
      {
        "word": "Shinapash, rikuychikyari.",
        "start": 291730,
        "end": 294070
      },
      {
        "word": "Tukuy mapata larkaman shitashka.",
        "start": 294285,
        "end": 296565
      },
      {
        "word": "Killkakatirkanchikmi nishkakunata, chaypika chay surkukkunaka mapayachishka petróleo mapayachishkataka allichishunmi nishkarkami.",
