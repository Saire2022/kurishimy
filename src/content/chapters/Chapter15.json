        "end": 379240
      },
      {
        "word": "Shinapash samaypash mapayashka kan.",
        "start": 379260,
        "end": 381640
      },
      {
        "word": "Wawakuna cáncerwan unkushka wacharin, llakirinchikmi.",
        "start": 381720,
