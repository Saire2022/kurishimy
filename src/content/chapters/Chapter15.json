        "end": 306620
      },
      {
        "word": "Yanka umachiklla kan.",
        "start": 306650,
        "end": 308410
      },
      {
        "word": "Chayamushka punchakunakarin wawkiku nin karyan.",
        "start": 308415,
        "end": 311435
      },
      {
        "word": "Wawkikuna, ama llakiriychikchu.",
