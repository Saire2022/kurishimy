        "end": 453750
      },
      {
        "word": "Yachashpami nin kashka.",
        "start": 453860,
        "end": 455300
      },
      {
        "word": "Sumak kawsay uyachik antamanta mashikuna.",
        "start": 456995,
        "end": 460185
      },
      {
        "word": "Shuk conexiónta charinchik Amazoníamanta.",
        "start": 460275,
        "end": 463035
      },
      {
        "word": "Ñukanchik mashikuna Fredy, Manuela rishka chaykunaman rikunkapak, hatun kiru pampakuna rupanakuymanta kay allpakunapi.",
        "start": 463080,
        "end": 471820
      },
      {
        "word": "Katipaychik, mashikuna.",
        "start": 471970,
        "end": 473610
      },
      {
        "word": "Rikushpapash mana kririnchu.",
        "start": 473675,
        "end": 475645
      },
      {
        "word": "Ushashka allpakunatami ña kutin rupachinakun.",
        "start": 475835,
        "end": 478995
      },
      {
        "word": "Responsablekunaka shutita charinmi.",
        "start": 479170,
        "end": 482210
      },
      {
        "word": "Empresa ganaderamanta dueñokunami kan.",
        "start": 482385,
        "end": 485515
      },
      {
        "word": "Shinalla kan yuyakpipash, kaytaka mana willachishkachu.",
        "start": 485580,
        "end": 489690
      },
      {
        "word": "Ñukanchik ñawikunawanpachami rikushkanchik.",
        "start": 489730,
        "end": 493020
      },
      {
        "word": "Chay rupashka allpakunapika kunanka coca nishka kiwatami tarpushka tiyan, coca nishka kiwata!",
        "start": 493090,
        "end": 500730
      },
      {
        "word": "Chaypillatak kutin kutin llakichiy tukushkanchik.",
        "start": 500800,
        "end": 504240
      },
      {
        "word": "Alli nishpaka rupachishka hawa, drogakunapash.",
        "start": 504880,
        "end": 508940
      },
      {
        "word": "Ashtawan llakikuna hawa, yana kuri nishka surkukkuna.",
        "start": 508960,
        "end": 513360
      },
      {
        "word": "Ña tubo pakirishkakuna tiyan.",
        "start": 513580,
        "end": 516350
      },
      {
        "word": "Na yacharinchu mashnapacha hicharishkata.",
        "start": 516420,
        "end": 519630
      },
      {
        "word": "Petróleomi yanayachishka yakuka ñami ishkay kilómetros larkata mapayachishka, kay yakuka shuk shuk ayllullaktakunatami purikun.",
        "start": 519710,
        "end": 528300
      },
      {
        "word": "Mana rimayta usharkanchikchu empresa petroleramantakunawan.",
        "start": 528330,
        "end": 531990
      },
      {
        "word": "Entrevistata mañarkanchik, relacionador público na chaypi nirka, kutinparakpash tikramuychik nirkami.",
        "start": 532230,
        "end": 539220
      },
      {
        "word": "Larkamanta shuk botella yakuta huntachishpa aparkanchik, paykuna mallichun.",
        "start": 539230,
        "end": 544530
      },
      {
        "word": "Rikuchun puntashna alli yuraklla yakuchu kan.",
        "start": 544810,
        "end": 549110
      },
      {
        "word": "Shinapash pipash mana ñawita rikuchirkachu.",
        "start": 549480,
        "end": 553200
      },
      {
        "word": "Willashpa katishun.",
        "start": 553545,
        "end": 555175
      },
      {
        "word": "Mashikuna, kaymi hatun llakikuna kan, empresakunaka maytapash rurashpa wañuchishpa sakin, estadopash mana rikunchu kay llaktakunataka.",
        "start": 555270,
        "end": 566970
      },
      {
        "word": "Kirukunata urmachishpa, petróleo nishkakunatayman hichashpa rin, kaykunami ñukanchik allpamamataka wañuchinakun.",
        "start": 567090,
        "end": 575440
      },
      {
        "word": "Llakichikkuna shutikunata charinmi, Amazonía allpakunapi kan.",
        "start": 575530,
        "end": 580280
      },
      {
        "word": "Llakichishkakunapash shutita charinmi, kay tukuy apya yalapi, ñukanchik hatun llaktapi.",
        "start": 580380,
        "end": 587210
      },
      {
