        "end": 367750
      },
      {
        "word": "Allpa ukupi tiyakkuna estadopa nin.",
        "start": 367750,
        "end": 370080
      },
      {
        "word": "Hawa pachapi tiyakkuna estadopa nin.",
        "start": 370140,
        "end": 372350
      },
      {
        "word": "Shinapash larkaka mana ukupi kanka.",
