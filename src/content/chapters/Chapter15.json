        "end": 393315
      },
      {
        "word": "Disparaychik!",
        "start": 393355,
        "end": 394215
      },
      {
        "word": "Pozokunaman rirkanchik harkankapak.",
        "start": 398970,
        "end": 401500
      },
      {
        "word": "Ñukanchik lanzakunata apashpa, na violenciata maskanakurkanchikchu, shinapash policíakuna disparay kallarirka.",
        "start": 401580,
        "end": 409800
      },
      {
        "word": "Locokuna kashna dispararka.",
        "start": 409880,
        "end": 411780
      },
      {
        "word": "Ishkay wawkikuna wañurka, chaymanta shuk wawkika escuelapi yachachik karka, allkutashna wañuchirka.",
        "start": 412660,
        "end": 420630
      },
      {
        "word": "Ñukanchik wañushkakunamanta wakanchik.",
        "start": 420810,
        "end": 423470
      },
      {
        "word": "Imata shinayta na ushashpa wakanchik.",
        "start": 423795,
        "end": 426295
      },
      {
        "word": "Shinapash chaypirak kan.",
        "start": 430970,
        "end": 433270
      },
      {
        "word": "Kay llaktapi justiciaka culebrashinami kan, chaki lluchu purikkunata kanin.",
        "start": 434150,
        "end": 439670
      },
      {
        "word": "Shinapash gobiernoka ñukanchik mamallaktaka petróleomantami kawsanchik nishka.",
        "start": 439810,
        "end": 445830
      },
      {
        "word": "Mejor niychikyari, petróleomanta wañunchik nishpa.",
        "start": 445910,
        "end": 449040
      },
      {
        "word": "Ñuka hatun yayaka ninmi karyan, petróleoka diablopa ismami kan nishpa.",
