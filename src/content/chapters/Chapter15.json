        "end": 315410
      },
      {
        "word": "Ñukanchikka alli paktachinata yachanchikmi.",
        "start": 315495,
        "end": 319185
      },
      {
        "word": "Tuberíakunapi ima mana alli kakpika, utkami allichishun.",
        "start": 319680,
        "end": 324930
      },
      {
        "word": "Kay chuya mayuka chayshinallatakmi sakirinka.",
        "start": 325460,
        "end": 329290
      },
      {
        "word": "Ayllullaktapakka llamkay tiyanka, yachana wasipish allichishka sakirinka, hampirina wasipish tiyankaman.",
