      {
        "word": "Ama mascarillata kunkanki.",
        "start": 215290,
        "end": 216910
      },
      {
        "word": "Alcaldesawan empanadata mikunkapak rinkakamanka, ñuka churi Fredy, uyachik antamanta Manuelantin, Amazoníapi shuk reportajeta shinanakurka.",
        "start": 218930,
        "end": 229130
      },
      {
        "word": "Nishpaka, kankunaka ganaderokunantin, cocalerokunantin, yapa llakipi urmashkankichik.",
