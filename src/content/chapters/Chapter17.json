      {
        "word": "Shinaka, shinaka, mashi Amaru, ñukaka na yachanichu imata tikrachinata.",
        "start": 705310,
        "end": 711730
      },
      {
        "word": "Kay medidas económicas, kay llakikuna paktarichunka chawpi llaktapi tiyak runakunami wasipi sakirina kan, kay doméstico llaktakunata gratis aparishpa.",
        "start": 711750,
        "end": 723740
      },
      {
        "word": "Chay chawpi llaktayukkunaka warmikunami kanchik.",
        "start": 723790,
        "end": 728165
      },
      {
        "word": "Shinapacha, Gumersinda!",
        "start": 728165,
        "end": 729865
      },
      {
        "word": "Capitalismoka imatapish uyak warmikuna, wachakkunatami mutsurin.",
        "start": 730020,
        "end": 735080
      },
      {
        "word": "Kullki illak tukuy veinticuatro pachakunata llamkachun, yanushpa, pichashpa, yachachishpa, hampishpa, wawakunata rikushpa, rukukunata rikushpa.",
        "start": 735240,
        "end": 747180
      },
      {
        "word": "Chaykunapak ayllukunata kamashpaka, charikkunapak bolsillokunatami kamakunkichik.",
        "start": 747630,
        "end": 753230
      },
      {
        "word": "Chayka umaymi kan.",
        "start": 753340,
        "end": 755100
      },
      {
        "word": "Na Diosta munaymanta ruranchu, Bibliamantapash mana ruranchu nachu?",
        "start": 755165,
        "end": 760885
      },
      {
        "word": "Na, kuyashka Gumersinda.",
        "start": 760890,
        "end": 763000
      },
      {
        "word": "Diospak shimitaka nimapak na munankunachu.",
        "start": 763010,
        "end": 766410
      },
      {
        "word": "Maki ukupika charinmi proyecto político y económico nishkata.",
        "start": 766620,
        "end": 771650
      },
      {
        "word": "Uyankichu chay nishkata?",
        "start": 779790,
        "end": 781370
      },
      {
        "word": "Pushakkuna Dios rimakkuna shinapish kullkita munan, dólarta munan.",
        "start": 781610,
        "end": 788400
      },
      {
        "word": "Kutin ñankunapi kaparikkunaka, ayllumanta kaparinkuna, mana yachaymantaka kay privatizaciónkunata hatun corporaciónkunata yanapanata munan.",
        "start": 788470,
        "end": 800830
      },
      {
        "word": "Kay Golden Hands nishkashina.",
        "start": 801110,
        "end": 803630
      },
      {
        "word": "Jaboneropak ayllullaktapi",
        "start": 805690,
        "end": 808180
      },
      {
        "word": "Pandemiamanta rimaykuna",
